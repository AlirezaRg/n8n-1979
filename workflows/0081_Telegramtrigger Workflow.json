      "typeVersion": 1,
      "position": [
        660,
        320
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"message\"][\"text\"]}}",
              "value2": "/deploy",
              "operation": "contains"
            }
          ]
        }
      }
    },
    {
      "id": "d15c735e-80b7-4b73-929d-09dd4631e7e4",
