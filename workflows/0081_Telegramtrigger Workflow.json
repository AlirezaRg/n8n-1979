      "typeVersion": 1,
      "position": [
        460,
        320
      ],
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": ""
      }
    },
    {
      "id": "06255bb3-8d38-49ef-845c-b698398bbbfc",
