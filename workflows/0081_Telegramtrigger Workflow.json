        "releaseTag": "={{$json[\"version\"]}}",
        "repository": "n8n",
        "authentication": "{{ $credentials.oAuth2 }}",
        "additionalFields": {}
      },
      "credentials": {
        "githubOAuth2Api": ""
      },
      "webhookId": "8d62857d-20ec-4c56-9d3d-ee23a38da395"
