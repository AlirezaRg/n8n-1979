  "nodes": [
    {
      "id": "b1afd02d-6edf-4540-bf32-09d87cb8a27b",
      "name": "Sticky Note3",
      "notes": "This stickyNote node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        320,
        220
      ],
      "parameters": {
        "color": 5,
        "width": 379,
        "height": 80,
        "content": "### ????? Setup\n1. Add your Gmail creds"
      }
    },
    {
      "id": "3481e6c3-7706-4c7f-8ca6-c96f76d82021",
      "name": "At midnight every work day",
      "notes": "This scheduleTrigger node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        400,
        340
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "3c74e4fd-e919-4acb-8092-658f2e71513b",
      "name": "Sticky Note2",
      "notes": "This stickyNote node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        380,
        520
      ],
      "parameters": {
        "color": 7,
        "width": 202,
        "height": 100,
        "content": "?? Set your schedule. I use this for work emails. For personal emails, I run this daily."
      }
    },
    {
      "id": "de421702-d012-4ea1-826e-1a4756ff4856",
      "name": "Get all emails in the last day",
      "notes": "This gmail node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "retryOnFail": true,
      "position": [
        620,
        340
      ],
      "parameters": {
        "filters": {
          "q": "label:inbox",
          "receivedBefore": "={{ $now.minus({days: 1}) }}"
        },
        "resource": "thread",
        "returnAll": true
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "{{ $credentials.gmailOAuth2.id }}",
          "name": "Work Gmail account"
        }
      },
      "webhookId": "3c7383e9-6d0f-46ed-990d-888324d16c0e"
    },
    {
      "id": "ef43b756-5f9c-4c8d-830a-8ccb71562618",
      "name": "Get the thread of each email",
      "notes": "This gmail node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "retryOnFail": true,
      "position": [
        840,
        340
      ],
      "parameters": {
        "options": {},
        "resource": "thread",
        "threadId": "={{ $json.id }}",
        "operation": "get"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "{{ $credentials.gmailOAuth2.id }}",
          "name": "Work Gmail account"
        }
      },
      "webhookId": "545e4e50-0b84-4503-8d45-828cb0a6805b"
    },
    {
      "id": "bfc3b7e1-651a-4eb5-8882-b21d120d982b",
      "name": "Keep only starred emails in inbox",
      "notes": "This filter node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 1,
      "position": [
        1060,
        340
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ JSON.stringify($json.messages).includes('STARRED') }}"
            }
          ]
        }
      }
    },
    {
      "id": "3d8145dc-577d-4e9b-83a7-fdf06afa1b96",
      "name": "for each message in the thread",
      "notes": "This itemLists node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 2,
      "position": [
        1480,
        520
      ],
      "parameters": {
        "options": {},
        "fieldToSplitOut": "messages"
      }
    },
    {
      "id": "1a9083a8-ffd2-403e-bf53-9b9eee87ff5b",
      "name": "Archive message (remove from inbox)",
      "notes": "This gmail node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "retryOnFail": true,
      "position": [
        1700,
        520
      ],
      "parameters": {
        "labelIds": "=INBOX",
        "messageId": "={{ $json.id }}",
        "operation": "removeLabels"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "{{ $credentials.gmailOAuth2.id }}",
          "name": "Work Gmail account"
        }
      },
      "webhookId": "3692e2e5-f2d6-454b-947d-3b9c72852ce5"
    },
