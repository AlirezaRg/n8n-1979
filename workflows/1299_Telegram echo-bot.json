      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        1040,
        340
      ],
      "parameters": {
        "updates": [
          "*"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "{{ $credentials.telegramApi.id }}",
          "name": "Telegram sdfsdfsdfsdfsfd_bot"
        }
      }
    },
    {
      "id": "5b890d30-f47e-4cf0-9747-ae9eb14cedff",
