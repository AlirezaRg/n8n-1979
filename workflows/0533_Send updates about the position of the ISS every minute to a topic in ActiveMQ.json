{
  "active": false,
  "name": "Send updates about the position of the ISS every minute to a topic in ActiveMQ",
  "settings": {},
  "nodes": [
    {
      "id": "node-6737d0af",
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        510,
        300
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      }
    },
    {
      "id": "node-d69aaa7b",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        710,
        300
      ],
      "parameters": {
        "url": "{{ $env.BASE_URL }}",
        "options": {},
        "queryParametersUi": {
          "parameter": [
            {
              "name": "timestamps",
              "value": "={{Date.now();}}"
            }
          ]
        }
      }
    },
    {
      "id": "node-7fd2aa20",
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        910,
        300
      ],
      "parameters": {
        "values": {
          "number": [
            {
              "name": "Latitude",
              "value": "={{$node[\"HTTP Request\"].json[\"0\"][\"latitude\"]}}"
            },
            {
              "name": "Longitude",
              "value": "={{$node[\"HTTP Request\"].json[\"0\"][\"longitude\"]}}"
            },
            {
              "name": "Timestamp",
              "value": "={{$node[\"HTTP Request\"].json[\"0\"][\"timestamp\"]}}"
            }
          ],
          "string": [
            {
              "name": "Name",
              "value": "={{$node[\"HTTP Request\"].json[\"0\"][\"name\"]}}"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      }
    },
    {
      "id": "node-fb19334f",
      "name": "AMQP Sender",
      "type": "n8n-nodes-base.amqp",
      "typeVersion": 1,
      "position": [
        1110,
        300
      ],
      "parameters": {
        "sink": "iss-postition",
        "options": {}
      },
      "credentials": {
        "amqp": "ampq"
      }
    },
    {
      "id": "error-e6458834",
      "name": "Error Handler",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "parameters": {
        "message": "Workflow execution error",
        "options": {}
      }
    }
  ],
  "connections": {}
}
