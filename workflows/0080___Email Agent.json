      "webhookId": "86c8c4b1-13bb-4ebe-acb9-30e1d7082d55",
      "notes": "This gmailTool node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.1,
      "position": [
        720,
