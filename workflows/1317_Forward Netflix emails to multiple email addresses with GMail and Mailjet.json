      "typeVersion": 3.2,
      "position": [
        940,
        360
      ],
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "recipients",
              "type": "arrayValue",
              "arrayValue": "['email1@example.com','email2@example.com','email3@example.com']"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "fe3affe4-0655-42b4-a0a6-b8b231180fbd",
