{
  "active": false,
  "name": "Create Onfleet tasks from Spreadsheets",
  "settings": {},
  "nodes": [
    {
      "id": "trigger-542018d4",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        100,
        100
      ],
      "parameters": {}
    },
    {
      "id": "8d5ecc2f-3011-40ee-a308-596ca39140af",
      "name": "Onfleet",
      "notes": "This onfleet node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.onfleet",
      "typeVersion": 1,
      "position": [
        900,
        280
      ],
      "parameters": {
        "operation": "create",
        "destination": {
          "destinationProperties": {
            "address": "={{$json[\"Address_Line1\"]}}, {{$json[\"Address_Line2\"]}}, {{$json[\"City/Town\"]}} {{$json[\"State/Province\"]}}, {{$json[\"Country\"]}}, {{$json[\"Postal_Code\"]}}",
            "unparsed": true,
            "addressNotes": "=",
            "addressApartment": "={{$json[\"Address_Line2\"]}}"
          }
        },
        "additionalFields": {
          "notes": "={{$json[\"Task_Details\"]}}",
          "recipient": {
            "recipientProperties": {
              "recipientName": "={{$json[\"Recipient_Name\"]}}",
              "recipientNotes": "={{$json[\"Recipient_Notes\"]}}",
              "recipientPhone": "=+1{{$json[\"Recipient_Phone\"]}}"
            }
          }
        }
      },
      "credentials": {
        "onfleetApi": {
          "id": "{{ $credentials.onfleetApi.id }}",
          "name": "Onfleet API Key"
        }
      }
    },
    {
      "id": "de10e413-1106-495c-ab2d-58d4e7c06b68",
      "name": "Read Binary File",
      "notes": "This readBinaryFile node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        500,
        280
      ],
      "parameters": {
        "filePath": "=/Users/jamesli/Downloads/Onfleet Import Google Sheet.xlsx"
      }
    },
    {
      "id": "9a7124e7-0503-423c-b4ce-c03e3063b201",
