      }
    },
    {
      "id": "c0e5472d-5208-4df7-89e8-380c2dab9642",
      "name": "Sticky Note3",
      "notes": "This stickyNote node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1300,
