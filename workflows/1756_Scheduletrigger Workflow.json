  "nodes": [
    {
      "id": "3a0ba7f4-ac41-49b0-a055-b993c82f2680",
      "name": "Every day at 9 am",
      "notes": "This scheduleTrigger node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        340,
        1280
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "5fa47f36-3206-44b9-965a-0d27b10acc21",
      "name": "Sticky Note2",
      "notes": "This stickyNote node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        740,
        980
      ],
      "parameters": {
        "width": 348.2877732355713,
        "height": 595.2986206729652,
        "content": "## Search for all contacts that last contact date for is known\n\n1. Setup Oauth2 creds using n8n docs\n{{ $env.WEBHOOK_URL }}\n\n### Be careful with scopes. Scopes must be exactly as defined in the n8n docs\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n### To make this more effective, we sort ascending by last contact date."
      }
    },
    {
      "id": "16b6fadf-ff1d-4670-b148-151cfbd242d5",
      "name": "Send outreach email",
      "notes": "This gmail node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        2040,
        1060
      ],
      "parameters": {
        "sendTo": "={{ $json.to }}",
        "message": "={{ $json.html }}",
        "options": {
          "senderName": "Mutasem from n8n",
          "appendAttribution": false
        },
        "subject": "={{ $json.subject }}"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "rd2agqPeJBD2377h",
          "name": "Work Gmail"
        }
      },
      "webhookId": "28824b28-8c19-4c16-bad4-8a90927ed4b3"
    },
    {
      "id": "a89ec3bd-7bb0-4dde-a9eb-800842073fc9",
      "name": "Sticky Note",
      "notes": "This stickyNote node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        2000,
        1300
      ],
      "parameters": {
        "color": 3,
        "width": 289.74216745960825,
        "height": 402.1775107197669,
        "content": "## Record engagement in Hubspot\n\nOnce engagement is added, last contact date is updated and won't show up in search results for another month.\n"
      }
    },
    {
      "id": "687509ed-4d25-4597-bade-1802348e42c9",
      "name": "Sticky Note1",
      "notes": "This stickyNote node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        260,
        980
      ],
      "parameters": {
        "color": 5,
        "width": 407.25356360335365,
        "height": 242.51175804432177,
        "content": "## Send followup email using Gmail to Hubspot contacts \n\nFollowing up at the right time is one of the most important parts of sales. This workflow uses Gmail to send outreach emails to Hubspot contacts that have already been contacted only once more than a month ago, and records the engagement in Hubspot. "
      }
    },
    {
      "id": "e66f48c9-0e19-4089-a4a4-d9e87b56898a",
      "name": "Record engagement in HubSpot",
      "notes": "This hubspot node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [
        2080,
        1500
      ],
      "parameters": {
        "type": "email",
        "metadata": {
          "html": "={{ $json.html }}",
          "subject": "={{ $json.subject }}",
          "toEmail": [
            "={{ $json.to }}"
          ],
          "firstName": "Mutasem",
          "fromEmail": "mutasem@n8n.io"
        },
        "resource": "engagement",
        "authentication": "{{ $credentials.oAuth2 }}",
        "additionalFields": {
          "associations": {
            "contactIds": "={{ $json.id }}"
          }
        }
      },
      "credentials": {
        "hubspotOAuth2Api": {
          "id": "Gxwfj6z9NwaEC3P5",
          "name": "HubSpot account 3"
        }
      }
    },
    {
      "id": "f90770cf-aa6c-4148-b471-2b28ed978f72",
      "name": "Get previously HubSpot contacts",
      "notes": "This hubspot node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [
        840,
        1280
      ],
      "parameters": {
        "operation": "search",
        "authentication": "{{ $credentials.oAuth2 }}",
        "filterGroupsUi": {
          "filterGroupsValues": [
            {
              "filtersUi": {
                "filterValues": [
                  {
                    "operator": "HAS_PROPERTY",
                    "propertyName": "notes_last_contacted|datetime"
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "sortBy": "notes_last_contacted",
          "direction": "ASCENDING",
          "properties": [
            "firstname",
            "lastname",
            "email",
            "notes_last_contacted"
          ]
        }
      },
      "credentials": {
        "hubspotOAuth2Api": {
          "id": "Gxwfj6z9NwaEC3P5",
          "name": "HubSpot account 3"
        }
      }
    },
    {
      "id": "751fd345-9fec-4c7c-b20b-1db86ce6df10",
      "name": "if last contacted before a month",
      "notes": "This if node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        1280
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "8d9ad7ef-6e1a-486c-9fac-419ad2660ace",
              "operator": {
                "type": "dateTime",
                "operation": "before"
              },
              "leftValue": "={{ $json.properties.notes_last_contacted }}",
              "rightValue": "={{ DateTime.now().minus({days: 30}) }}"
            }
          ]
        }
      }
    },
    {
      "id": "52596987-ef7f-4dd7-98e7-6c3aaf6c2853",
      "name": "Get Hubspot Contact to engagement",
      "notes": "This httpRequest node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1340,
        1280
      ],
      "parameters": {
        "url": "{{ $env.BASE_URL }}",
        "options": {},
        "authentication": "{{ $credentials.predefinedCredentialType }}",
        "nodeCredentialType": "YOUR_CREDENTIAL_HERE"
      },
      "credentials": {
        "hubspotOAuth2Api": {
          "id": "Gxwfj6z9NwaEC3P5",
          "name": "HubSpot account 3"
        }
      }
    },
    {
      "id": "fe0bc120-8bee-41fa-a896-3c9ff8cf3a29",
      "name": "if there has been only one engagement",
      "notes": "This if node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1560,
        1280
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "07c7e29c-eed1-4872-a9f7-b833bb0cafca",
              "operator": {
                "type": "number",
                "operation": "equals"
              },
              "leftValue": "={{ $json.results.length }}",
              "rightValue": 1
            }
          ]
        }
      }
    },
    {
      "id": "512909c7-104b-4507-b91e-aa5b5a9410e5",
