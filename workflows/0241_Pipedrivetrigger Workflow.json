      "notes": "This pipedriveTrigger node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.pipedriveTrigger",
      "typeVersion": 1,
      "position": [
        440,
        500
      ],
      "parameters": {
        "action": "added",
        "object": "product"
      },
      "credentials": {
        "pipedriveApi": {
          "id": "{{ $credentials.pipedriveApi.id }}",
          "name": "Pipedrive account"
        }
      }
    },
    {
      "id": "a64af9df-3084-4376-ace9-50f0f21bbf35",
      "name": "Set item to only current product data",
      "notes": "This functionItem node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.functionItem",
      "typeVersion": 1,
      "position": [
        680,
        500
      ],
      "parameters": {
        "functionCode": "// Code here will run once per input item.\n// More info and help: {{ $env.WEBHOOK_URL }}\n// Tip: You can use luxon for dates and $jmespath for querying JSON structures\n\n// Add a new field called 'myNewField' to the JSON of the item\nitem = item.current;\n\n// You can write logs to the browser console\nconsole.log('Done!');\n\nreturn item;"
      }
    },
    {
      "id": "79b265a9-4021-4a1a-9b4a-4f3aeace9fe5",
      "name": "Create product in Stripe",
      "notes": "This httpRequest node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        900,
        660
      ],
      "parameters": {
        "url": "{{ $env.API_BASE_URL }}",
        "options": {},
        "requestMethod": "POST",
        "authentication": "{{ $credentials.predefinedCredentialType }}",
        "queryParametersUi": {
          "parameter": [
            {
              "name": "name",
              "value": "={{ $json[\"name\"] }}"
            },
            {
              "name": "description",
              "value": "={{ $json[\"description\"] || ' '}}"
            }
          ]
        },
        "nodeCredentialType": "YOUR_CREDENTIAL_HERE"
      },
      "credentials": {
        "stripeApi": {
          "id": "{{ $credentials.stripeApi.id }}",
          "name": "Stripe account"
        }
      }
    },
    {
      "id": "69e40a2b-1680-42f9-add9-cbef9bc0f63f",
      "name": "Add created product Id to data",
      "notes": "This merge node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 1,
      "position": [
        1320,
        520
      ],
      "parameters": {
        "mode": "mergeByIndex"
      }
    },
    {
      "id": "bc7428ba-829f-4a9b-af61-ea11c102d1d3",
      "name": "Keep only productId of created product",
      "notes": "This set node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1100,
        660
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "StripeCreatedProductId",
              "value": "={{ $json[\"id\"] }}"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      }
    },
    {
      "id": "8571acfb-8ee9-410d-a5ca-9b173d034202",
      "name": "Create price records in Stripe",
      "notes": "This httpRequest node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1760,
        520
      ],
      "parameters": {
        "url": "{{ $env.API_BASE_URL }}",
        "options": {},
        "requestMethod": "POST",
        "authentication": "{{ $credentials.predefinedCredentialType }}",
        "queryParametersUi": {
          "parameter": [
            {
              "name": "currency",
              "value": "={{ $json[\"prices\"].currency }}"
            },
            {
              "name": "unit_amount",
              "value": "={{ $json[\"prices\"].price * 100 }}"
            },
            {
              "name": "product",
              "value": "={{ $json[\"StripeCreatedProductId\"] }}"
            }
          ]
        },
        "nodeCredentialType": "YOUR_CREDENTIAL_HERE"
      },
      "credentials": {
        "stripeApi": {
          "id": "{{ $credentials.stripeApi.id }}",
          "name": "Stripe account"
        }
      }
    },
    {
      "id": "f849ae73-aa7d-49b2-81a9-7470278d30a3",
      "name": "Split prices to seperate items",
      "notes": "This itemLists node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 1,
      "position": [
        1540,
        520
      ],
      "parameters": {
        "include": "selectedOtherFields",
        "options": {},
        "fieldToSplitOut": "prices",
        "fieldsToInclude": {
          "fields": [
            {
              "fieldName": "StripeCreatedProductId"
            }
          ]
        }
      }
