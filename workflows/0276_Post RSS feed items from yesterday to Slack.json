{
  "active": false,
  "name": "Post RSS feed items from yesterday to Slack",
  "settings": {},
  "nodes": [
    {
      "id": "02d94495-39a8-4e5b-b062-8fa23314984f",
      "name": "Build our message",
      "notes": "This function node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1160,
        400
      ],
      "parameters": {
        "functionCode": "// Create our Slack message\n// This will output a list of RSS items in the following format\n// Title - Description\nlet message = \"*:new: Posts from yesterday :new:*\\n\\n\";\n\n// Loop the input items\nfor (item of items) {\n  message += \"*<\" + item.json.link + \"|\" + item.json.title + \">*\\n\" + item.json.contentSnippet + \"\\n\\n\"; \n}\n\n// Return our message\nreturn [{json: {message}}];"
      }
    },
    {
      "id": "04f11124-a075-4b47-a7da-3436aa6b2f44",
      "name": "Every Morning",
      "notes": "This cron node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        380,
        420
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "hour": 8
            }
          ]
        }
      }
    },
    {
      "id": "e1e7f17b-4078-438a-b5c0-e131459c0e24",
      "name": "Get Yesterdays Date",
      "notes": "This dateTime node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.dateTime",
      "typeVersion": 1,
      "position": [
        560,
        420
      ],
      "parameters": {
        "value": "={{Date()}}",
        "action": "calculate",
        "options": {},
        "duration": 1,
        "operation": "subtract"
      }
    },
    {
      "id": "d5deffba-9276-42b5-b511-aeae5fb832d9",
      "name": "Get the RSS Feed",
      "notes": "This rssFeedRead node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [
        740,
        420
      ],
      "parameters": {
        "url": "{{ $env.WEBHOOK_URL }}"
      }
    },
    {
      "id": "f34862d9-a439-4e92-a070-de8f8491e3d5",
      "name": "If it was published after yesterday",
      "notes": "This if node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "continueOnFail": true,
      "position": [
        940,
        420
      ],
      "parameters": {
        "conditions": {
          "dateTime": [
            {
              "value1": "={{$item(0).$node[\"Get Yesterdays Date\"].json.data}}",
              "value2": "={{$json[\"pubDate\"]}}",
              "operation": "before"
            }
          ]
        }
      }
    },
    {
      "id": "1cc94ad9-db4f-49bc-923d-eb41ffcfecde",
      "name": "Post to Slack",
      "notes": "This slack node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [
        1340,
        400
      ],
      "parameters": {
        "text": "={{$json[\"message\"]}}",
        "channel": "#news",
        "blocksUi": {
          "blocksValues": []
        },
        "attachments": [],
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": {
          "id": "{{ $credentials.slackApi.id }}",
          "name": "Slack Access Token"
        }
      }
    },
    {
      "id": "error-4eb90417",
      "name": "Error Handler",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "parameters": {
        "message": "Workflow execution error",
        "options": {}
      }
    }
  ],
  "connections": {}
}
