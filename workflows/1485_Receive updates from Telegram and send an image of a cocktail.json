{
  "active": false,
  "name": "Receive updates from Telegram and send an image of a cocktail",
  "settings": {},
  "nodes": [
    {
      "id": "node-dd58f9c6",
      "name": "Telegram Trigger",
      "webhookId": "806cc2c6-c687-4022-a82e-658e4a684e73",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        570,
        260
      ],
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": "telegram-bot"
      }
    },
    {
      "id": "node-ff4b8027",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        770,
        260
      ],
      "parameters": {
        "url": "{{ $env.BASE_URL }}",
        "options": {}
      }
    },
    {
      "id": "node-dae1abb2",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        970,
        260
      ],
      "parameters": {
        "file": "={{$node[\"HTTP Request\"].json[\"drinks\"][0][\"strDrinkThumb\"]}}",
        "chatId": "={{$node[\"Telegram Trigger\"].json[\"message\"][\"chat\"][\"id\"]}}",
        "operation": "sendPhoto",
        "additionalFields": {
          "caption": "={{$node[\"HTTP Request\"].json[\"drinks\"][0][\"strDrink\"]}}",
          "reply_to_message_id": "={{$node[\"Telegram Trigger\"].json[\"message\"][\"message_id\"]}}"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": null,
          "name": "telegram-bot"
        }
      },
      "webhookId": "6ed46638-3011-4421-8583-65c47d0e9af4"
    },
    {
      "id": "error-ec279d3e",
      "name": "Error Handler",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "parameters": {
        "message": "Workflow execution error",
        "options": {}
      }
    }
  ],
  "connections": {}
}
