      "position": [
        790,
        500
      ],
      "parameters": {
        "coinIds": [
          "bitcoin"
        ],
        "options": {},
        "operation": "price",
        "currencies": [
          "eur"
        ]
      }
    },
    {
      "id": "9fd68e83-05e1-4278-98f6-f8be2a207860",
