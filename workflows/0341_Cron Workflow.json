{
  "active": false,
  "name": "Cron Workflow",
  "settings": {},
  "nodes": [
    {
      "id": "dbfc88c9-36e2-4cce-b661-e6767fcae129",
      "name": "Cron",
      "notes": "This cron node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        100,
        160
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "hour": 5,
              "mode": "everyWeek"
            }
          ]
        }
      }
    },
    {
      "id": "87bb83bd-c47f-4d2b-a0df-095c63bbf30e",
      "name": "MySQL - insert",
      "notes": "This mySql node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 1,
      "position": [
        500,
        160
      ],
      "parameters": {
        "table": "books",
        "columns": "title, price",
        "options": {
          "ignore": true,
          "priority": "LOW_PRIORITY"
        }
      },
      "credentials": {
        "mySql": {
          "id": "{{ $credentials.mySql.id }}",
          "name": "MySQL account"
        }
      }
    },
    {
      "id": "98e3c71d-cecd-4176-a968-28c1fa8176aa",
      "name": "Google Sheets - read",
      "notes": "This googleSheets node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [
        300,
        160
      ],
      "parameters": {
        "options": {},
        "sheetId": "qwertz",
        "authentication": "{{ $credentials.oAuth2 }}"
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "{{ $credentials.googleSheetsOAuth2Api.id }}",
          "name": "google_sheets_oauth"
        }
      }
    },
    {
      "id": "error-11461790",
      "name": "Error Handler",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "parameters": {
        "message": "Workflow execution error",
        "options": {}
      }
    }
  ],
  "connections": {}
}
