      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "c24405f8-267f-4933-a178-1b51145d62bf",
              "name": "price",
              "type": "string",
              "value": "={{ $json[\"text\"].match(/\\$(\\d+(\\.\\d{2})?)/)[1] }}"
            },
            {
              "id": "968cf7cd-6e28-4328-a829-3fe2cb327643",
              "name": "shop",
              "type": "string",
              "value": "={{ $json[\"text\"].match(/?????([\\u4e00-\\u9fa5a-zA-Z0-9\\s]+)??/)[1] }}"
            },
            {
              "id": "53642bcb-f3a6-4086-bdc1-2f8d27927462",
              "name": "date",
              "type": "string",
              "value": "={{ $json[\"text\"].match(/Date: (\\d{4}?\\d{1,2}?\\d{1,2}?)/)[1].replace(\"?\", \".\").replace(\"?\", \".\").replace(\"?\", \"\") }}"
            },
            {
              "id": "cd227132-971b-4970-8b5d-724463efe036",
              "name": "time",
              "type": "string",
              "value": "={{ \n  $json[\"text\"].match(/(??|??) (\\d{1,2}):(\\d{2})/) ? \n  ($json[\"text\"].match(/(??|??) (\\d{1,2}):(\\d{2})/)[1] === '??' && $json[\"text\"].match(/(??|??) (\\d{1,2}):(\\d{2})/)[2] !== '12' \n    ? (parseInt($json[\"text\"].match(/(??|??) (\\d{1,2}):(\\d{2})/)[2]) + 12) + ':' + $json[\"text\"].match(/(??|??) (\\d{1,2}):(\\d{2})/)[3] \n    : $json[\"text\"].match(/(??|??) (\\d{1,2}):(\\d{2})/)[2] + ':' + $json[\"text\"].match(/(??|??) (\\d{1,2}):(\\d{2})/)[3]\n  )\n  : null \n}}"
            }
          ]
        }
      }
    },
