    {
      "id": "6a3ee9b0-540e-4242-a6ac-535e2b23ea3a",
      "name": "Sticky Note6",
      "notes": "This stickyNote node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -680,
