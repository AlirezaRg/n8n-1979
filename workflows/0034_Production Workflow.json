      "typeVersion": 1,
      "position": [
        1680,
        280
      ],
      "parameters": {
        "fileName": "={{$node[\"Config\"].parameter[\"values\"][\"string\"][0][\"value\"]}}"
      }
    },
    {
      "id": "node-14a690e0",
      "name": "Read Binary File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "alwaysOutputData": true,
      "continueOnFail": true,
      "position": [
        580,
