{
  "active": false,
  "name": "AccountCraft WhatsApp Automation - Infridet",
  "settings": {},
  "nodes": [
    {
      "id": "1",
      "name": "Webhook - Lead Capture",
      "notes": "This webhook node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "path": "lead-capture",
        "responseMode": "onReceived"
      },
      "webhookId": "9d4b8d9f-989e-4bae-8c48-b5cd63e0bd52"
    },
    {
      "id": "2",
      "name": "Google Sheets - Backup Log",
      "notes": "This googleSheets node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [
        500,
        200
      ],
      "parameters": {
        "range": "Leads!A1",
        "options": {},
        "sheetId": "your_google_sheet_id_here",
        "valueInputMode": "USER_ENTERED"
      },
      "credentials": {
        "googleApi": "Google Account"
      }
    },
    {
      "id": "3",
      "name": "FluentCRM - Add Contact",
      "notes": "This httpRequest node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        500,
        400
      ],
      "parameters": {
        "url": "{{ $env.WEBHOOK_URL }}",
        "method": "POST",
        "options": {},
        "jsonParameters": true,
        "bodyParametersJson": "{\n  \"email\": \"{{$json[\"email\"]}}\",\n  \"first_name\": \"{{$json[\"name\"]}}\",\n  \"tags\": [\"New Lead\"]\n}"
      },
      "credentials": {
        "httpBasicAuth": {
          "user": "your_crm_api_user",
          "password": "{{ $credentials.password }}"
        }
      }
    },
    {
      "id": "4",
      "name": "Send Warmup Email",
      "notes": "This emailSend node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        750,
        200
      ],
      "parameters": {
        "text": "Hey {{$json[\"name\"]}},\n\nThanks for joining Account Craft! We'll help you build your YouTube channel and earn like a pro. Stay tuned. ??\n\nCheers,\nGyan",
        "subject": "Welcome to Account Craft ??",
        "toEmail": "={{$json[\"email\"]}}",
        "fromEmail": "your@email.com"
      },
      "credentials": {
        "smtp": "SMTP Account"
      }
    },
    {
      "id": "5",
      "name": "Send WhatsApp via Whinta",
      "notes": "This httpRequest node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "url": "{{ $env.API_BASE_URL }}",
        "method": "POST",
        "options": {},
        "jsonParameters": true,
        "bodyParametersJson": "{\n  \"phone\": \"{{$json[\"phone\"]}}\",\n  \"message\": \"Hey {{$json[\"name\"]}}, Gyan here from Account Craft ?? Just saw your form - want help starting your YouTube channel?\"\n}"
      }
    },
    {
      "id": "6",
      "name": "Update CRM Tag to Customer",
      "notes": "This httpRequest node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1250,
        200
      ],
      "parameters": {
        "url": "{{ $env.WEBHOOK_URL }}",
        "method": "POST",
        "options": {},
        "jsonParameters": true,
        "bodyParametersJson": "{\n  \"email\": \"{{$json[\"email\"]}}\",\n  \"tags\": [\"Customer\"]\n}"
      },
      "credentials": {
        "httpBasicAuth": {
          "user": "your_crm_api_user",
          "password": "{{ $credentials.password }}"
        }
      }
    }
  ],
  "connections": {}
}
