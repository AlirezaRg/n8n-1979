{
  "active": false,
  "name": "Scrape Twitter for mentions of company",
  "settings": {},
  "nodes": [
    {
      "id": "600d8d84-ac22-4afd-9d1b-7ccff17f8a34",
      "name": "Filter Tweet Data",
      "notes": "This set node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1260,
        300
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "Tweet",
              "value": "={{$node[\"Get last 50 mentions\"].json[\"text\"]}}"
            },
            {
              "name": "Tweet URL",
              "value": "={{ $env.WEBHOOK_URL }}{{$node[\"Get last 50 mentions\"].json[\"user\"][\"screen_name\"]}}/status/{{$node[\"Get last 50 mentions\"].json[\"id_str\"]}}"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      }
    },
    {
      "id": "d3bb9d53-d66c-4191-8423-0ce3b29b0f7a",
      "name": "Run Every 10 Minutes",
      "notes": "This cron node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        260,
        320
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyX",
              "unit": "minutes",
              "value": 10
            }
          ]
        }
      }
    },
    {
      "id": "eb067db9-dba8-4905-809a-89b4e8434846",
      "name": "Now - 10 minutes",
      "notes": "This dateTime node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.dateTime",
      "typeVersion": 1,
      "position": [
        620,
        320
      ],
      "parameters": {
        "value": "={{Date()}}",
        "action": "calculate",
        "options": {},
        "duration": "={{$node[\"Run Every 10 Minutes\"].parameter[\"triggerTimes\"][\"item\"][0][\"value\"]}}",
        "timeUnit": "={{$node[\"Run Every 10 Minutes\"].parameter[\"triggerTimes\"][\"item\"][0][\"unit\"]}}",
        "operation": "subtract"
      }
    },
    {
      "id": "6420b041-8915-4502-9df7-1c62ef48b95b",
      "name": "Get last 50 mentions",
      "notes": "This twitter node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 1,
      "position": [
        820,
        320
      ],
      "parameters": {
        "operation": "search",
        "searchText": "={{$node[\"Setup\"].parameter[\"values\"][\"string\"][1][\"value\"]}}",
        "additionalFields": {}
      },
      "credentials": {
        "twitterOAuth1Api": {
          "id": "{{ $credentials.twitterOAuth1Api.id }}",
          "name": "86-88 Twitter"
        }
      }
    },
    {
      "id": "4bbde00c-b777-43e0-ae29-c576bd886273",
      "name": "Created since last run?",
      "notes": "This if node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1020,
        320
      ],
      "parameters": {
        "conditions": {
          "dateTime": [
            {
              "value1": "={{$json[\"created_at\"]}}",
              "value2": "={{$items(\"Now - 10 minutes\", 0, 0)[0].json.data}}"
            }
          ]
        }
      }
    },
    {
      "id": "48c4f3ec-8c34-4403-bc72-c4284b26c2e2",
      "name": "Setup",
      "notes": "This set node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        440,
        320
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "slackChannel",
              "value": "#recent-tweets"
            },
            {
              "name": "twitterSearchValue",
              "value": "@n8n_io"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "8abb8abe-6a4b-486a-9407-1d4820fdc7f6",
      "name": "Post to Slack",
      "notes": "This slack node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "text": "=New Mention!: {{$node[\"Filter Tweet Data\"].json[\"Tweet\"]}}.\nSee it here: {{$node[\"Filter Tweet Data\"].json[\"Tweet URL\"]}}",
        "channel": "={{$node[\"Setup\"].parameter[\"values\"][\"string\"][0][\"value\"]}}",
        "attachments": [],
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": {
          "id": "{{ $credentials.slackApi.id }}",
          "name": "Slack Access Token"
        }
      }
    },
    {
      "id": "error-96a8d3ad",
      "name": "Error Handler",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "parameters": {
        "message": "Workflow execution error",
        "options": {}
      }
    }
  ],
  "connections": {}
}
