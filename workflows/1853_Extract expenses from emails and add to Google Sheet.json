{
  "active": false,
  "name": "Extract expenses from emails and add to Google Sheet",
  "settings": {},
  "nodes": [
    {
      "id": "trigger-ce75c2bc",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        100,
        100
      ],
      "parameters": {}
    },
    {
      "id": "b15e5cbe-1ca2-4e8d-9c41-15fb4c0b639f",
      "name": "Check subject",
      "notes": "This if node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        800,
        300
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"subject\"].toLowerCase()}}",
              "value2": "=/{{$json[\"subjectPatterns\"].toLowerCase()}}/",
              "operation": "regex"
            }
          ]
        },
        "combineOperation": "any"
      }
    },
    {
      "id": "3bb8576e-9b1b-4d02-b88f-7f93bc37e04f",
      "name": "Setup Variables",
      "notes": "This set node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        620,
        300
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "subjectPatterns",
              "value": "(expenses|reciept)"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "baf1dfb8-0486-4dfc-b7c8-320d21ed2743",
      "name": "Check for new emails",
      "notes": "This emailReadImap node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 1,
      "position": [
        440,
        300
      ],
      "parameters": {
        "format": "resolved",
        "mailbox": "Inbox",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "credentials": {
        "imap": {
          "id": "{{ $credentials.imap.id }}",
          "name": "GMAIL"
        }
      }
    },
    {
      "id": "17b1387f-46e7-4184-a49d-a99eb1d518e3",
      "name": "Read Receipts",
      "notes": "This mindee node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.mindee",
      "typeVersion": 1,
      "position": [
        1020,
        280
      ],
      "parameters": {
        "binaryPropertyName": "attachment_0"
      },
      "credentials": {
        "mindeeReceiptApi": {
          "id": "{{ $credentials.mindeeReceiptApi.id }}",
          "name": "Mindee Receipt account"
        }
      }
    },
    {
      "id": "d04b42ee-32e2-4985-aeff-86727cf0ebff",
      "name": "Set column data",
      "notes": "This set node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1200,
        280
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "Date",
              "value": "={{$json[\"date\"]}}"
            },
            {
              "name": "Description",
              "value": "={{$node[\"Check for new emails\"].json[\"subject\"].split(\"-\")[1]}}"
            },
            {
              "name": "Category",
              "value": "={{$json[\"category\"]}}"
            },
            {
              "name": "Currency",
              "value": "={{$json[\"currency\"]}}"
            },
            {
              "name": "Amount",
              "value": "={{$json[\"total\"]}}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "0e943e58-3b1b-4bc3-8906-12838b9e6dbe",
      "name": "Add to Google Sheet",
      "notes": "This googleSheets node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [
        1380,
        280
      ],
      "parameters": {
        "range": "A:E",
        "options": {},
        "sheetId": "1xAtx1ORZYKu4urgqpOe3DawFjiWeOZO0VCVvOlQYnaE",
        "operation": "append",
        "authentication": "{{ $credentials.oAuth2 }}"
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "{{ $credentials.googleSheetsOAuth2Api.id }}",
          "name": "Sheets"
        }
      }
    }
  ],
  "connections": {}
}
