{
  "active": false,
  "name": "Moving metrics from Google Sheets to Orbit",
  "settings": {},
  "nodes": [
    {
      "id": "trigger-c3ff08d0",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        100,
        100
      ],
      "parameters": {}
    },
    {
      "id": "0198f23f-9a98-4c46-9497-887c7beeb55a",
      "name": "Merge",
      "notes": "This merge node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 1,
      "position": [
        1473,
        426
      ],
      "parameters": {
        "mode": "mergeByKey",
        "propertyName1": "GitHub Username",
        "propertyName2": "attributes.slug"
      }
    },
    {
      "id": "3a494ce0-bc49-4d29-9300-bbb754f7809b",
      "name": "Add Members",
      "notes": "This orbit node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.orbit",
      "typeVersion": 1,
      "position": [
        1073,
        326
      ],
      "parameters": {
        "operation": "upsert",
        "identityUi": {
          "identityValue": {
            "source": "github",
            "searchBy": "username",
            "username": "={{$json[\"GitHub\"]}}"
          }
        },
        "workspaceId": "543",
        "additionalFields": {
          "name": "={{$json[\"Name\"]}}",
          "tShirt": "={{$json[\"T-Shirt Size\"]}}",
          "location": "={{$json[\"Location\"]}}",
          "tagsToAdd": "={{$json[\"Tags\"]}}"
        }
      },
      "credentials": {
        "orbitApi": "Orbit Credentials"
      }
    },
    {
      "id": "468fc5a0-3886-411f-8299-9bcaab8d0ee2",
      "name": "Get all members",
      "notes": "This orbit node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.orbit",
      "typeVersion": 1,
      "position": [
        1273,
        526
      ],
      "parameters": {
        "options": {},
        "operation": "getAll",
        "returnAll": true,
        "workspaceId": "543"
      },
      "credentials": {
        "orbitApi": {
          "id": null,
          "name": "Orbit Credentials"
        }
      }
    },
    {
      "id": "939e3d97-fbb8-42ed-9737-7b7a7b740fb5",
      "name": "Get Members",
      "notes": "This googleSheets node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [
        873,
        326
      ],
      "parameters": {
        "range": "Members!A:F",
        "options": {},
        "sheetId": "1GiR5glinWBUJ-pw3w8LpcuwyOXst2z5nnFSak8DQrMQ",
        "authentication": "{{ $credentials.oAuth2 }}"
      },
      "credentials": {
        "googleSheetsOAuth2Api": "Google Sheets Credentials"
      }
    },
    {
      "id": "c36b6168-5d3a-40d5-963a-0009e6e37b96",
      "name": "Get Activities",
      "notes": "This googleSheets node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [
        1273,
        326
      ],
      "parameters": {
        "range": "Activities!A:D",
        "options": {
          "returnAllMatches": true
        },
        "sheetId": "={{$node[\"Get Members\"].parameter[\"sheetId\"]}}",
        "operation": "lookup",
        "lookupValue": "={{$node[\"Get Members\"].json[\"GitHub\"]}}",
        "lookupColumn": "GitHub Username",
        "authentication": "{{ $credentials.oAuth2 }}"
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": null,
          "name": "Google Sheets Credentials"
        }
      }
    },
    {
      "id": "9bca0a06-a20a-486d-8d03-1f727aede037",
      "name": "Add Activities",
      "notes": "This orbit node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.orbit",
      "typeVersion": 1,
      "position": [
        1673,
        426
      ],
      "parameters": {
        "title": "={{$json[\"Title\"]}}",
        "memberId": "={{$json[\"id\"]}}",
        "resource": "activity",
        "workspaceId": "543",
        "additionalFields": {
          "link": "={{$json[\"Activity Link\"]}}",
          "description": "={{$node[\"Merge\"].json[\"Description\"]}}"
        }
      },
      "credentials": {
        "orbitApi": {
          "id": null,
          "name": "Orbit Credentials"
        }
      }
    },
    {
      "id": "error-6f751cca",
      "name": "Error Handler",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "parameters": {
        "message": "Workflow execution error",
        "options": {}
      }
    }
  ],
  "connections": {}
}
