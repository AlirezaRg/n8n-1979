  "nodes": [
    {
      "id": "a7de36ee-13a8-42b4-ac38-877f9a867c68",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -736,
        16
      ],
      "parameters": {}
    },
    {
      "id": "8126afd2-58fa-4c75-bd99-0876784fd1c3",
      "name": "Classify Error",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        -528,
        -32
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.execution.error.message }}",
                    "rightValue": "401|403|unauthorized|auth|forbidden",
                    "operator": {
                      "type": "string",
                      "operation": "regex"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "AUTH_ERROR"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.execution.error.message }}",
                    "rightValue": "timeout|ECONNRESET|ETIMEDOUT",
                    "operator": {
                      "type": "string",
                      "operation": "regex"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "TIMEOUT"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.execution.error.message }}",
                    "rightValue": "rate limit|429|too many requests",
                    "operator": {
                      "type": "string",
                      "operation": "regex"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "RATE_LIMIT"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.execution.error.message }}",
                    "rightValue": "ENOTFOUND|network|connection refused",
                    "operator": {
                      "type": "string",
                      "operation": "regex"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "NETWORK"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "95ea8496-5972-4d7d-91e4-35092d47f858",
      "name": "Set Error Type",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -272,
        16
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a732aac2",
              "name": "errorType",
              "value": "={{\n$json.errorOutput === 0 ? '🔴 CRITICAL (AUTH)' :\n$json.errorOutput === 1 ? '🟠 SERIOUS (TIMEOUT)' :\n$json.errorOutput === 2 ? '🟡 WARNING (RATE LIMIT)' :\n$json.errorOutput === 3 ? '🟡 WARNING (NETWORK)' :\n'🔵 INFO'\n}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
