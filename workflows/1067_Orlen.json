    {
      "id": "1bb0161e-1a38-4533-909c-a9e9425d7536",
      "name": "Current date",
      "notes": "This function node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1160,
        960
      ],
      "parameters": {
        "functionCode": "var today = new Date();\nvar year = today.getFullYear();\nvar month = today.getMonth() + 1;\nvar day = today.getDate();\n\nif(month < 10) {\n  month = \"0\" + month;\n}\n\nitems[0].json.year = year;\nitems[0].json.month = month;\nitems[0].json.day = day;\n\nreturn items;"
      }
    },
    {
      "id": "78cd2038-7309-4626-84d2-53a69468661b",
      "name": "Every 23:45",
      "notes": "This cron node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        960,
        960
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "hour": 23,
              "minute": 45
            }
          ]
        }
      }
    },
    {
