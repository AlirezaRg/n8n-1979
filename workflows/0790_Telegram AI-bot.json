      "notes": "This telegramTrigger node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        20,
        340
      ],
      "parameters": {
        "updates": [
          "*"
