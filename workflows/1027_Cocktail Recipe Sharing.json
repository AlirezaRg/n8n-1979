{
  "active": false,
  "name": "Cocktail Recipe Sharing",
  "settings": {},
  "nodes": [
    {
      "id": "node-a1ea1d00",
      "name": "Bannerbear",
      "type": "n8n-nodes-base.bannerbear",
      "typeVersion": 1,
      "position": [
        650,
        300
      ],
      "parameters": {
        "templateId": "",
        "modificationsUi": {
          "modificationsValues": [
            {
              "name": "cocktail-image",
              "imageUrl": "{{ $env.BASE_URL }}"
            },
            {
              "name": "title",
              "text": "={{$node[\"HTTP Request\"].json[\"drinks\"][0][\"strDrink\"]}}"
            },
            {
              "name": "recipe",
              "text": "={{$node[\"HTTP Request\"].json[\"drinks\"][0][\"strInstructions\"]}}"
            }
          ]
        },
        "additionalFields": {
          "waitForImage": true
        }
      },
      "credentials": {
        "bannerbearApi": "Bannerbear"
      }
    },
    {
      "id": "node-8f00819a",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        450,
        300
      ],
      "parameters": {
        "url": "{{ $env.BASE_URL }}",
        "options": {}
      }
    },
    {
      "id": "node-29251480",
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "hour": 18,
              "mode": "everyWeek",
              "weekday": "5"
            }
          ]
        }
      }
    },
    {
      "id": "node-2c14021b",
      "name": "Rocketchat",
      "type": "n8n-nodes-base.rocketchat",
      "typeVersion": 1,
      "position": [
        850,
        300
      ],
      "parameters": {
        "channel": "",
        "options": {},
        "attachments": [
          {
            "imageUrl": "{{ $env.BASE_URL }}"
          }
        ]
      },
      "credentials": {
        "rocketchatApi": "Rocket"
      }
    },
    {
      "id": "error-9313c43c",
      "name": "Error Handler",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "parameters": {
        "message": "Workflow execution error",
        "options": {}
      }
    }
  ],
  "connections": {}
