{
  "active": false,
  "name": "Googlesheets Workflow",
  "settings": {},
  "nodes": [
    {
      "id": "13bef79a-e880-4db0-9b12-1a6a3c0b4c88",
      "name": "Google Sheets",
      "notes": "This googleSheets node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [
        1240,
        1120
      ],
      "parameters": {
        "range": "A:D",
        "options": {},
        "sheetId": "qwertz",
        "operation": "append",
        "authentication": "{{ $credentials.oAuth2 }}"
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "{{ $credentials.googleSheetsOAuth2Api.id }}",
          "name": "google_sheets_oauth"
        }
      }
    },
    {
      "id": "ba05ee88-981c-4043-a98e-6439a9ce6684",
      "name": "AWS Transcribe 2",
      "notes": "This awsTranscribe node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.awsTranscribe",
      "typeVersion": 1,
      "position": [
        920,
        1120
      ],
      "parameters": {
        "operation": "get",
        "transcriptionJobName": "={{$json[\"Key\"]}}"
      },
      "credentials": {
        "aws": {
          "id": "{{ $credentials.aws.id }}",
          "name": "aws"
        }
      }
    },
    {
      "id": "2506b121-ac0d-4b6e-8026-2732c45de8d4",
      "name": "AWS Transcribe 1",
      "notes": "This awsTranscribe node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.awsTranscribe",
      "typeVersion": 1,
      "position": [
        600,
        1120
      ],
      "parameters": {
        "options": {},
        "mediaFileUri": "=s3://{{$node[\"AWS S3 2\"].parameter[\"bucketName\"]}}/{{$json[\"Key\"]}}",
        "transcriptionJobName": "={{$json[\"Key\"]}}"
      },
      "credentials": {
        "aws": {
          "id": "{{ $credentials.aws.id }}",
          "name": "aws"
        }
      }
    },
    {
      "id": "078b14e8-d4a0-44f8-acde-0db7e1fc62c6",
      "name": "AWS S3 1",
      "notes": "This awsS3 node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.awsS3",
      "typeVersion": 1,
      "position": [
        280,
        1120
      ],
      "parameters": {
        "tagsUi": {
          "tagsValues": [
            {
              "key": "YOUR_CREDENTIAL_HERE",
              "value": "gdrive"
            }
          ]
        },
        "fileName": "={{$json[\"name\"]}}",
        "operation": "upload",
        "binaryData": false,
        "bucketName": "mybucket",
        "fileContent": "street",
        "additionalFields": {}
      },
      "credentials": {
        "aws": {
          "id": "{{ $credentials.aws.id }}",
          "name": "aws"
        }
      }
    },
    {
      "id": "511845ba-ca6c-41d0-856d-c4bacc23b345",
      "name": "AWS S3 2",
      "notes": "This awsS3 node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.awsS3",
      "typeVersion": 1,
      "position": [
        440,
        1120
      ],
      "parameters": {
        "options": {},
        "operation": "getAll",
        "bucketName": "mybucket"
      },
      "credentials": {
        "aws": {
          "id": "{{ $credentials.aws.id }}",
          "name": "aws"
        }
      }
    },
    {
      "id": "810a08ce-af7f-4803-bf6d-4d856acfcc0f",
      "name": "Set",
      "notes": "This set node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1080,
        1120
      ],
      "parameters": {
        "values": {
          "number": [
            {
              "name": "transcription_date",
              "value": "={{$node[\"AWS Transcribe 1\"].json[\"CreationTime\"]}}"
            }
          ],
          "string": [
            {
              "name": "recording_name",
              "value": "={{$node[\"AWS Transcribe 1\"].json[\"TranscriptionJobName\"]}}"
            },
            {
              "name": "recording_link",
              "value": "={{$node[\"Google Drive Trigger\"].json[\"webContentLink\"]}}"
            },
            {
              "name": "transcription",
              "value": "={{$json[\"transcript\"]}}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "20535b08-26ae-4ea0-86cc-21895d99d8f0",
      "name": "Google Drive Trigger1",
      "notes": "This googleDriveTrigger node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        120,
        1120
      ],
      "parameters": {
        "event": "fileCreated",
        "options": {},
        "triggerOn": "specificFolder",
        "folderToWatch": "{{ $env.WEBHOOK_URL }}[your_id]"
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "{{ $credentials.googleDriveOAuth2Api.id }}",
          "name": "Google Drive account"
        }
      }
    },
    {
      "id": "22192620-3b67-4b52-8800-38097fd43019",
      "name": "Wait",
      "webhookId": "12345",
      "notes": "This wait node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        760,
        1120
      ],
      "parameters": {
        "resume": "webhook",
        "options": {
          "responsePropertyName": "transcript"
        },
        "responseMode": "lastNode"
      }
    },
    {
      "id": "error-154e6ef7",
      "name": "Error Handler",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "parameters": {
        "message": "Workflow execution error",
        "options": {}
      }
    }
  ],
  "connections": {}
}
