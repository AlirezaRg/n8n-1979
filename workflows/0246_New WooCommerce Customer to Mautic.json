{
  "active": false,
  "name": "New WooCommerce Customer to Mautic",
  "settings": {},
  "nodes": [
    {
      "id": "aaa4d55f-1f51-43f1-a083-8267a0b6bf58",
      "name": "Check for Existing",
      "notes": "This mautic node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.mautic",
      "typeVersion": 1,
      "alwaysOutputData": true,
      "position": [
        280,
        480
      ],
      "parameters": {
        "options": {
          "search": "={{$json[\"email\"]}}"
        },
        "operation": "getAll",
        "authentication": "{{ $credentials.oAuth2 }}"
      },
      "credentials": {
        "mauticOAuth2Api": {
          "id": "{{ $credentials.mauticOAuth2Api.id }}",
          "name": "Mautic account"
        }
      }
    },
    {
      "id": "7fc2998a-28b9-485c-855b-c0805a5ca5b9",
      "name": "If New",
      "notes": "This if node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        460,
        480
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"id\"]}}",
              "operation": "isEmpty"
            }
          ]
        }
      }
    },
    {
      "id": "c725b4ec-d8aa-4a3e-890b-fdaa94a28aaa",
      "name": "Create Contact",
      "notes": "This mautic node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.mautic",
      "typeVersion": 1,
      "position": [
        680,
        320
      ],
      "parameters": {
        "email": "={{$node[\"Customer Created\"].json[\"email\"]}}",
        "company": "={{$node[\"Customer Created\"].json[\"billing\"][\"company\"]}}",
        "options": {},
        "lastName": "={{$node[\"Customer Created\"].json[\"last_name\"]}}",
        "firstName": "={{$node[\"Customer Created\"].json[\"first_name\"]}}",
        "authentication": "{{ $credentials.oAuth2 }}",
        "additionalFields": {}
      },
      "credentials": {
        "mauticOAuth2Api": {
          "id": "{{ $credentials.mauticOAuth2Api.id }}",
          "name": "Mautic account"
        }
      }
    },
    {
      "id": "83dd0803-82b3-4680-a381-3916f3d46040",
      "name": "Update Contact",
      "notes": "This mautic node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.mautic",
      "typeVersion": 1,
      "position": [
        680,
        580
      ],
      "parameters": {
        "options": {},
        "contactId": "={{$json[\"id\"]}}",
        "operation": "update",
        "updateFields": {
          "lastName": "={{$node[\"Customer Created or Updated\"].json[\"last_name\"]}}",
          "firstName": "={{$node[\"Customer Created or Updated\"].json[\"first_name\"]}}"
        },
        "authentication": "{{ $credentials.oAuth2 }}"
      },
      "credentials": {
        "mauticOAuth2Api": {
          "id": "{{ $credentials.mauticOAuth2Api.id }}",
          "name": "Mautic account"
        }
      }
    },
    {
      "id": "e614bf25-e63a-4dc7-8c59-b4052fb319f6",
      "name": "Customer Created or Updated",
      "webhookId": "5d89e322-a5e0-4cce-9eab-185e8375175b",
      "notes": "This wooCommerceTrigger node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.wooCommerceTrigger",
      "typeVersion": 1,
      "position": [
        100,
        480
      ],
      "parameters": {
        "event": "customer.updated"
      },
      "credentials": {
        "wooCommerceApi": {
          "id": "{{ $credentials.wooCommerceApi.id }}",
          "name": "WooCommerce account"
        }
      }
    },
    {
      "id": "error-74c3ad8c",
      "name": "Error Handler",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "parameters": {
        "message": "Workflow execution error",
        "options": {}
      }
    }
  ],
  "connections": {}
}
