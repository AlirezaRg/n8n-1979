{
  "active": false,
  "name": "Activity Encouragement",
  "settings": {},
  "nodes": [
    {
      "id": "83b7ca9a-24cb-42d2-ba1b-5a4e90c8c302",
      "name": "Strava",
      "notes": "This strava node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.strava",
      "typeVersion": 1,
      "position": [
        640,
        300
      ],
      "parameters": {
        "operation": "getAll",
        "returnAll": true
      },
      "credentials": {
        "stravaOAuth2Api": "Strava OAuth2 Creds"
      }
    },
    {
      "id": "ee30ac7b-f7f5-497e-8286-f0cfc4d671ce",
      "name": "Accountability Settings",
      "notes": "This set node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        450,
        300
      ],
      "parameters": {
        "values": {
          "number": [
            {
              "name": "moveTime",
              "value": 1800
            }
          ],
          "string": [
            {
              "name": "actPartner1",
              "value": "john.doe@example.com"
            },
            {
              "name": "actPartner2",
              "value": "jane.doe@example.com"
            },
            {
              "name": "actPartner3",
              "value": "jill.doe@example.com"
            },
            {
              "name": "yourName",
              "value": "Jim"
            },
            {
              "name": "yourEmail",
              "value": "jim.doe@example.com"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      }
    },
    {
      "id": "b01d7d05-1348-4da6-883c-d5c5e45c9785",
      "name": "Check Activity Level",
      "notes": "This if node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        840,
        300
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$node[\"Strava\"].json[\"moving_time\"]}}",
              "value2": "={{$node[\"Accountability Settings\"].parameter[\"values\"][\"number\"][0][\"value\"]}}",
              "operation": "largerEqual"
            }
          ]
        }
      }
    },
    {
      "id": "1bfd8628-f1b3-418e-8897-c91749d5adce",
      "name": "Enough Activity",
      "notes": "This noOp node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1050,
        220
      ],
      "parameters": {}
    },
    {
      "id": "f84739ce-a42e-4ecf-b373-6d6ce0b90d37",
      "name": "Send Email",
      "notes": "This emailSend node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        1050,
        390
      ],
      "parameters": {
        "text": "=Hey Accountability Team,\n\nLooks like {{$node[\"Accountability Settings\"].json[\"yourName\"]}} has been spending a bit too much time inactive! How about sending them a quick word of encouragement?\n\nThanks!\n{{$node[\"Accountability Settings\"].json[\"yourName\"]}}'s Heart",
        "options": {},
        "toEmail": "={{$node[\"Accountability Settings\"].parameter[\"values\"][\"string\"][0][\"value\"]}}; {{$node[\"Accountability Settings\"].parameter[\"values\"][\"string\"][1][\"value\"]}}; {{$node[\"Accountability Settings\"].parameter[\"values\"][\"string\"][2][\"value\"]}}",
        "fromEmail": "={{$node[\"Accountability Settings\"].json[\"yourEmail\"]}}"
      },
      "credentials": {
        "smtp": "Email Creds"
      }
    },
    {
      "id": "e9ca11fe-78d4-4ab4-888c-0d6cb784a41e",
      "name": "Check Daily at 11:AM",
      "notes": "This cron node performs automated tasks as part of the workflow.",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        260,
        300
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "hour": 11
            }
          ]
        }
      }
    }
  ],
  "connections": {}
}
