        "additionalFields": {
          "person_id": "={{ $json[\"id\"] }}"
        }
      },
      "credentials": {
        "pipedriveApi": {
          "id": "{{ $credentials.pipedriveApi.id }}",
          "name": "Pipedrive account"
        }
      }
