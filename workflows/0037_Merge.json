            {
              "name": "files[1]",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "data2"
            }
          ]
        },
        "genericAuthType": "httpQueryAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/octet-stream"
            }
          ]
        }
      },
      "credentials": {
