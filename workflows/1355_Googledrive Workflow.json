      "parameters": {
        "jsCode": "// This function will create an array of file links from the given Google Drive folder\nreturn items.map(file => {\n  return { json: { 'link': `{{ $env.WEBHOOK_URL }}{file.json.id}&export=download&confirm=t&authuser=0`, 'name': file.json.name } };\n});"
